# Used ONLY by local scripts (npm run seed). The Forge app itself never reads this file.
# Copy to .env and fill in YOUR OWN values. Never commit .env, never share your token.
ATLASSIAN_SITE=your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=
# Jira project to seed demo tickets into (create a Scrum/Kanban project with this key first)
TETHER_JIRA_PROJECT_KEY=PAY
# Confluence space for decision records (script creates it if missing)
TETHER_CONFLUENCE_SPACE_KEY=ENG
TETHER_CONFLUENCE_SPACE_NAME=Engineering Decisions
